# Copiază acest fișier în ".env" și completează valorile reale.
# NU adăuga fișierul ".env" în Git / nu-l trimite nimănui.
#
# ACEST BACKEND E SEPARAT de cel al asistentului modulului Broderie
# (assistent-ai/backend/.env) — rulează ca serviciu propriu, cu propriile
# chei/secrete. Poți refolosi ACEEAȘI cheie Anthropic și ACELAȘI cont
# Resend ca la asistentul Broderie (nu sunt limitate la un singur consumator),
# dar WIDGET_SHARED_SECRET și ADMIN_API_SECRET trebuie să fie VALORI
# DIFERITE de cele din asistentul Broderie, ca un secret scurs de la un
# asistent să nu dea acces și la celălalt.

# Cheia API Anthropic (console.anthropic.com -> API Keys) — poate fi
# aceeași cheie folosită și de asistentul Broderie.
ANTHROPIC_API_KEY=sk-ant-...

# Modelul folosit (implicit Haiku 4.5 — rapid și ieftin)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Calea către baza de cunoștințe a modulului Digitizare (implicit un
# nivel deasupra folderului backend). La deploy, cel mai simplu e să
# copiezi Baza_de_cunostinte_Digitizare.md în interiorul folderului
# backend/ și să setezi KB_PATH=./Baza_de_cunostinte_Digitizare.md
KB_PATH=../Baza_de_cunostinte_Digitizare.md

# Trimiterea notificărilor de email se face prin Resend (API HTTP, nu SMTP).
# Poți folosi ACELAȘI cont Resend ca la asistentul Broderie.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Adresa "from". Poți folosi un nume diferit ca să distingi ușor emailurile
# celor două asistente în inbox (ex. "Asistent Digitizare" vs "Asistent Curs Broderie").
RESEND_FROM=Asistent Digitizare <onboarding@resend.dev>

# Adresa care primește notificările cu întrebări nevalidate
NOTIFY_EMAIL=embro.expert@gmail.com

# Domeniul de pe care va fi apelat backend-ul (widgetul embed pe cursdebroderie.ro)
ALLOWED_ORIGIN=https://cursdebroderie.ro

# Port local — DIFERIT de portul asistentului Broderie (3001), ca să poți
# rula ambele backend-uri simultan pe aceeași mașină în timpul testării locale.
PORT=3002

# Limitare cereri (protecție cost API) — implicit 30 întrebări/oră per IP
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=3600000

# Secret partajat cu widgetul Digitizare — OBLIGATORIU, și DIFERIT de
# WIDGET_SHARED_SECRET al asistentului Broderie. Generează o valoare random:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WIDGET_SHARED_SECRET=

# Secret separat, DOAR pentru rute de administrare — DIFERIT de
# ADMIN_API_SECRET al asistentului Broderie.
ADMIN_API_SECRET=

# Logare opțională într-un Google Sheet (poate fi același Sheet ca la
# asistentul Broderie, într-un tab separat, sau un webhook complet
# separat — payload-ul include "source":"digitizare" ca să le poți distinge).
SHEET_LOG_WEBHOOK_URL=
SHEET_LOG_TOKEN=
